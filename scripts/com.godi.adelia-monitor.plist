<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Outside monitor for adelia.godi.ai, every 5 minutes (audit 2.9).
  Install:  cp scripts/com.godi.adelia-monitor.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.godi.adelia-monitor.plist
  Remove:   launchctl unload ~/Library/LaunchAgents/com.godi.adelia-monitor.plist
  Edit the two paths below if the repo lives somewhere else.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.godi.adelia-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/scripts/monitor-adelia.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME_PATH/.local/state/adelia-monitor/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PATH/.local/state/adelia-monitor/stderr.log</string>
</dict>
</plist>
