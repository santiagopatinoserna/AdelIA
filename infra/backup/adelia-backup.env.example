# /etc/adelia-backup.env on the server: root:root, chmod 600 (docs/BACKUPS.md).
# systemd reads it as root before the backup runs as santiago.

# The private repository the backups go to. Never a public one.
ADELIA_BACKUP_REPO=owner/adelia-backups

# The age PUBLIC key (age1...). The private key never comes to the server:
# the server must not be able to read its own backups.
ADELIA_BACKUP_RECIPIENT=age1replace-with-the-public-key

# Fine-grained token: only that repository, permission Contents read and write.
GITHUB_TOKEN=github_pat_replace-me

# Optional:
# ADELIA_BACKUP_KEEP_DAYS=30
# ADELIA_BACKUP_WORKDIR=/var/tmp/adelia-backup
