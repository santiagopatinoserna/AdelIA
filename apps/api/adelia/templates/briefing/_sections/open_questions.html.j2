<section class="section">
  <h2>Open questions (Q&amp;A pre-baker)</h2>
  {% if payload.sections.open_questions %}
    {% for qa in payload.sections.open_questions %}
    <div class="qa-item">
      <div class="q">Q{{ loop.index }}: {{ qa.question }}</div>
      <div class="a">{{ qa.answer }}{% for c in qa.citations %}<sup class="citation" data-citation-id="{{ c.entity_id }}">[{{ loop.index }}]</sup>{% endfor %}</div>
    </div>
    {% endfor %}
  {% else %}
    <p class="no-data">No pre-baked questions generated.</p>
  {% endif %}
</section>
