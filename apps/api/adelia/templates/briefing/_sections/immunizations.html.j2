<section class="section">
  <h2>{{ labels.immunizations }}</h2>
  {% if payload.sections.immunizations %}
  <ul>
    {% for i in payload.sections.immunizations %}
    <li>
      {{ i.name }}{% if i.date %} — {{ i.date }}{% endif %}
      <span class="provenance-badge {{ i.provenance }}"></span>
      {% for c in i.citations %}<sup class="citation" data-citation-id="{{ c.entity_id }}">[{{ loop.index }}]</sup>{% endfor %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="no-data">{{ labels.no_immunizations }}</p>
  {% endif %}
</section>
