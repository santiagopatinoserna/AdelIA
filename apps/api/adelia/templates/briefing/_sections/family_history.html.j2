<section class="section">
  <h2>{{ labels.family_history }}</h2>
  {% if payload.sections.family_history %}
  <ul>
    {% for f in payload.sections.family_history %}
    <li>
      <strong>{{ f.relation }}</strong>: {{ f.condition }}
      <span class="provenance-badge {{ f.provenance }}"></span>
      {% for c in f.citations %}<sup class="citation" data-citation-id="{{ c.entity_id }}">[{{ loop.index }}]</sup>{% endfor %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="no-data">{{ labels.no_family_history }}</p>
  {% endif %}
</section>
