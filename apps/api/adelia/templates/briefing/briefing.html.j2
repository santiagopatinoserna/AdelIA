<!DOCTYPE html>
<html lang="{{ labels.lang }}">
<head>
  <meta charset="utf-8">
  <title>AdelIA Briefing · {{ payload.patient.name }} · {{ payload.target_specialty.value }}</title>
  <link rel="stylesheet" href="/static/briefing/briefing.css">
</head>
<body class="briefing">
  <header class="briefing-header">
    {#- Age and sex come from Profile now (audit 3.10). The header used to
        read "0 años ?" for every patient, whatever their real age, because it
        was built from the User row. A missing date of birth prints
        "edad no registrada" rather than a zero a pediatrician would act on. -#}
    {%- set p = payload.patient -%}
    {%- if p.age_months is none -%}
      {%- set age_text = labels.age_unknown -%}
    {%- elif p.age_months < 24 -%}
      {%- set age_text = p.age_months ~ " " ~ (labels.month if p.age_months == 1 else labels.months) -%}
    {%- else -%}
      {%- set years = (p.age_months // 12) -%}
      {%- set age_text = years ~ " " ~ (labels.year if years == 1 else labels.years) -%}
    {%- endif -%}
    {%- if p.sex == "M" -%}
      {%- set sex_text = labels.sex_m -%}
    {%- elif p.sex == "F" -%}
      {%- set sex_text = labels.sex_f -%}
    {%- else -%}
      {%- set sex_text = labels.sex_unknown -%}
    {%- endif -%}
    <h1>AdelIA Briefing · {{ p.name }} · {{ age_text }} · {{ sex_text }}</h1>
    <div class="meta">
      {{ labels.generated }}: {{ payload.generated_at.strftime("%Y-%m-%d %H:%M UTC") }}
      · {{ labels.target_specialty }}: <strong>{{ payload.target_specialty.value | replace("_", " ") }}</strong>
    </div>
  </header>

  {% include "briefing/_sections/reason_for_consult.html.j2" %}
  {% include "briefing/_sections/active_problems.html.j2" %}
  {% include "briefing/_sections/medications.html.j2" %}
  {% include "briefing/_sections/allergies.html.j2" %}
  {% if payload.sections.immunizations is not none %}
    {% include "briefing/_sections/immunizations.html.j2" %}
  {% endif %}
  {% include "briefing/_sections/procedures.html.j2" %}
  {% if payload.sections.family_history is not none %}
    {% include "briefing/_sections/family_history.html.j2" %}
  {% endif %}
  {% include "briefing/_sections/relevant_observations.html.j2" %}
  {% include "briefing/_sections/open_questions.html.j2" %}

  {% if payload.evidence_citations %}
  <section class="section evidence">
    <h2>{{ labels.evidence }}</h2>
    <ul>
      {% for ev in payload.evidence_citations %}
      <li>
        <strong>[{{ ev.tag }}]</strong>
        {{ ev.title }}
        {% if ev.organization %} — {{ ev.organization }}{% endif %}
        {% if ev.year %} ({{ ev.year }}){% endif %}
        {% if ev.url %} · <a href="{{ ev.url }}" target="_blank" rel="noopener">{{ labels.source }}</a>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer class="disclaimer">
    <p>{{ labels.disclaimer }}</p>
  </footer>
</body>
</html>
